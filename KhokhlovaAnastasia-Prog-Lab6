        "Вариант 37: УЗИ/Диагностика\n",
        "\n",
        "Описание: Настройки ультразвуковых сканеров: усиление сигнала, глубина зондирования, частота кадров, артефакты.\n",
        "Обеспечение качества визуализации.\n",
        "\"\"\"\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from google.colab import files\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"ЛАБОРАТОРНАЯ РАБОТА №6\")\n",
        "print(\"Обработка данных ультразвуковых сканеров\")\n",
        "print(\"Студент: Хохлова АП | Группа: ИВТб-1305\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# 1. Загрузка данных\n",
        "print(\"\\n【1】 ЗАГРУЗКА ДАННЫХ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "uploaded = files.upload()\n",
        "df = pd.read_csv(\"data.csv\")\n",
        "\n",
        "print(f\"✓ Загружен файл: data.csv\")\n",
        "print(f\"✓ Исходная форма: {df.shape}\")\n",
        "print(f\"✓ Колонки: {list(df.columns)}\")\n",
        "\n",
        "# 2. Приведение типов данных\n",
        "print(\"\\n【2】 ПРИВЕДЕНИЕ ТИПОВ ДАННЫХ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "df = df.astype({\n",
        "    'ts': 'int32',       # время сканирования\n",
        "    'probe_id': 'int16', # ID датчика\n",
        "    'gain': 'float32',   # усиление сигнала, дБ\n",
        "    'depth': 'float32',  # глубина зондирования, см\n",
        "    'fps': 'float32',    # частота кадров, Гц\n",
        "    'art': 'uint8'       # индекс артефактов (0–10)\n",
        "})\n",
        "\n",
        "print(f\"✓ Типы данных приведены:\")\n",
        "print(df.dtypes)\n",
        "print(f\"✓ Форма данных: {df.shape}\")\n",
        "\n",
        "# Преобразуем в структурированный массив NumPy для эффективной работы\n",
        "arr = df.to_records(index=False)\n",
        "print(f\"✓ Поля: {arr.dtype.names}\")\n",
        "print(f\"✓ Память: {arr.nbytes / 1024**2:.2f} МБ\")\n",
        "\n",
        "# 3. Очистка данных\n",
        "print(\"\\n【3】 ОЧИСТКА ДАННЫХ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "# depth < 0 → удаляем (физически невозможно)\n",
        "mask_depth_negative = arr['depth'] < 0\n",
        "print(f\"Строк с depth < 0: {mask_depth_negative.sum()} ({mask_depth_negative.mean()*100:.2f}%)\")\n",
        "\n",
        "# fps < 1 → заменяем на 1 (clip снизу)\n",
        "fps_below_1 = arr['fps'] < 1\n",
        "print(f\"Строк с fps < 1: {fps_below_1.sum()}\")\n",
        "arr['fps'] = np.clip(arr['fps'], 1, None)\n",
        "\n",
        "# art ∉ [0,10] → ограничиваем по шкале\n",
        "art_out_of_range = (arr['art'] < 0) | (arr['art'] > 10)\n",
        "print(f\"Строк с art вне [0,10]: {art_out_of_range.sum()}\")\n",
        "arr['art'] = np.clip(arr['art'], 0, 10)\n",
        "\n",
        "# Проверка NaN\n",
        "print(f\"\\nNaN в данных:\")\n",
        "for field in ['gain', 'depth', 'fps', 'art']:\n",
        "    nan_count = np.isnan(arr[field]).sum()\n",
        "    print(f\"  {field}: {nan_count}\")\n",
        "\n",
        "# Заполнение NaN (если есть)\n",
        "if np.isnan(arr['gain']).any():\n",
        "    median_gain = np.nanmedian(arr['gain'])\n",
        "    arr['gain'] = np.where(np.isnan(arr['gain']), median_gain, arr['gain'])\n",
        "    print(f\"  gain: заполнено медианой {median_gain:.2f}\")\n",
        "\n",
        "if np.isnan(arr['depth']).any():\n",
        "    median_depth = np.nanmedian(arr['depth'])\n",
        "    arr['depth'] = np.where(np.isnan(arr['depth']), median_depth, arr['depth'])\n",
        "    print(f\"  depth: заполнено медианой {median_depth:.2f}\")\n",
        "\n",
        "if np.isnan(arr['fps']).any():\n",
        "    median_fps = np.nanmedian(arr['fps'])\n",
        "    arr['fps'] = np.where(np.isnan(arr['fps']), median_fps, arr['fps'])\n",
        "    print(f\"  fps: заполнено медианой {median_fps:.2f}\")\n",
        "\n",
        "if np.isnan(arr['art']).any():\n",
        "    median_art = np.nanmedian(arr['art'])\n",
        "    arr['art'] = np.where(np.isnan(arr['art']), median_art, arr['art'])\n",
        "    print(f\"  art: заполнено медианой {median_art:.0f}\")\n",
        "\n",
        "# Удаление строк с отрицательной глубиной\n",
        "valid_mask = arr['depth'] >= 0\n",
        "removed_count = (~valid_mask).sum()\n",
        "print(f\"\\nУдалено строк с depth < 0: {removed_count}\")\n",
        "arr = arr[valid_mask]\n",
        "print(f\"✓ Финальная форма: {arr.shape}\")\n",
        "\n",
        "# 4. Группировка по probe_id\n",
        "print(\"\\n【4】 ГРУППИРОВКА ПО PROBE_ID\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "unique_probes = np.unique(arr['probe_id'])\n",
        "print(f\"Количество датчиков: {len(unique_probes)}\")\n",
        "\n",
        "# Создаем массивы для хранения результатов\n",
        "probe_ids = []\n",
        "avg_gain_per_probe = []\n",
        "max_fps_per_probe = []\n",
        "std_gain_per_probe = []\n",
        "avg_art_per_probe = []\n",
        "count_per_probe = []\n",
        "\n",
        "for probe in unique_probes:\n",
        "    mask = arr['probe_id'] == probe\n",
        "    probe_ids.append(probe)\n",
        "    count_per_probe.append(mask.sum())\n",
        "    avg_gain_per_probe.append(np.mean(arr['gain'][mask]))\n",
        "    std_gain_per_probe.append(np.std(arr['gain'][mask]))\n",
        "    max_fps_per_probe.append(np.max(arr['fps'][mask]))\n",
        "    avg_art_per_probe.append(np.mean(arr['art'][mask]))\n",
        "\n",
        "print(\"\\nСтатистика по датчикам (первые 10):\")\n",
        "print(f\"{'probe_id':>8} {'count':>8} {'avg_gain':>10} {'std_gain':>10} {'max_fps':>12} {'avg_art':>10}\")\n",
        "print(\"-\" * 65)\n",
        "for i in range(min(10, len(probe_ids))):\n",
        "    print(f\"{probe_ids[i]:8d} {count_per_probe[i]:8d} {avg_gain_per_probe[i]:10.3f} \"\n",
        "          f\"{std_gain_per_probe[i]:10.3f} {max_fps_per_probe[i]:12.3f} {avg_art_per_probe[i]:10.3f}\")\n",
        "\n",
        "# 5. Скользящее окно и дифференциалы\n",
        "print(\"\\n【5】 СКОЛЬЗЯЩЕЕ ОКНО И ДИФФЕРЕНЦИАЛЫ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "k = 20  # размер окна\n",
        "\n",
        "# Moving average для gain\n",
        "cumsum_gain = np.cumsum(np.insert(arr['gain'], 0, 0))\n",
        "moving_avg_gain = (cumsum_gain[k:] - cumsum_gain[:-k]) / k\n",
        "moving_avg_gain = np.pad(moving_avg_gain, (k-1, 0), constant_values=np.nan)\n",
        "\n",
        "# Добавляем в DataFrame\n",
        "df_clean = pd.DataFrame(arr)\n",
        "df_clean['gain_ma20'] = moving_avg_gain\n",
        "\n",
        "print(f\"✓ Moving average (окно={k}): добавлено поле gain_ma20\")\n",
        "print(f\"  NaN в MA: {np.isnan(moving_avg_gain).sum()} (первые {k-1} элементов)\")\n",
        "\n",
        "# np.diff(depth) — изменения глубины\n",
        "depth_diff = np.diff(arr['depth'])\n",
        "depth_diff = np.pad(depth_diff, (1, 0), constant_values=0)\n",
        "df_clean['depth_change'] = depth_diff\n",
        "\n",
        "print(f\"✓ Изменения глубины: диапазон [{np.min(depth_diff):.2f}, {np.max(depth_diff):.2f}] см/кадр\")\n",
        "\n",
        "# 6. Создание признаков\n",
        "print(\"\\n【6】 СОЗДАНИЕ ПРИЗНАКОВ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "# Нормализация артефактов\n",
        "art_normalized = arr['art'] / 10.0\n",
        "df_clean['art_normalized'] = art_normalized\n",
        "print(f\"Артефакты (норм.): среднее = {np.mean(art_normalized):.3f}\")\n",
        "\n",
        "# Стабильность усиления (чем меньше вариация, тем стабильнее)\n",
        "gain_std_by_probe = np.zeros(len(arr), dtype=np.float32)\n",
        "for probe in unique_probes:\n",
        "    mask = arr['probe_id'] == probe\n",
        "    gain_std_by_probe[mask] = np.std(arr['gain'][mask])\n",
        "df_clean['gain_std_by_probe'] = gain_std_by_probe\n",
        "print(f\"Стабильность gain: среднее = {np.mean(gain_std_by_probe):.2f} дБ\")\n",
        "\n",
        "# Эффективность: fps / (артефакты + 1)\n",
        "efficiency = arr['fps'] / (arr['art'] + 1)\n",
        "df_clean['efficiency'] = efficiency\n",
        "print(f\"Эффективность: среднее = {np.mean(efficiency):.2f}\")\n",
        "\n",
        "# 7. Условная агрегация\n",
        "print(\"\\n【7】 УСЛОВНАЯ АГРЕГАЦИЯ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "bad_quality_mask = arr['art'] > 7\n",
        "bad_quality_count = bad_quality_mask.sum()\n",
        "print(f\"Кадры с высоким уровнем артефактов (art > 7): {bad_quality_count} ({bad_quality_count/len(arr)*100:.2f}%)\")\n",
        "\n",
        "print(\"\\nСреднее усиление при высоких артефактах (по датчикам):\")\n",
        "print(f\"{'Датчик':>8} {'ср. gain':>12} {'n':>8}\")\n",
        "print(\"-\" * 32)\n",
        "displayed = 0\n",
        "for probe in unique_probes:\n",
        "    mask = (arr['probe_id'] == probe) & bad_quality_mask\n",
        "    if mask.sum() > 0 and displayed < 10:\n",
        "        avg_gain_bad = np.mean(arr['gain'][mask])\n",
        "        print(f\"{probe:8d} {avg_gain_bad:12.2f} {mask.sum():8d}\")\n",
        "        displayed += 1\n",
        "\n",
        "# 8. Лаговые признаки\n",
        "print(\"\\n【8】 ЛАГОВЫЕ ПРИЗНАКИ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "# Лаг для gain (изменение усиления)\n",
        "lag_gain = np.roll(arr['gain'], 1)\n",
        "lag_gain[0] = arr['gain'][0]\n",
        "gain_delta = arr['gain'] - lag_gain\n",
        "\n",
        "# Лаг для depth (изменение глубины)\n",
        "lag_depth = np.roll(arr['depth'], 1)\n",
        "lag_depth[0] = arr['depth'][0]\n",
        "depth_delta = arr['depth'] - lag_depth\n",
        "\n",
        "# Статистика изменений gain\n",
        "gain_increase = np.sum(gain_delta > 0)\n",
        "gain_decrease = np.sum(gain_delta < 0)\n",
        "gain_unchanged = np.sum(gain_delta == 0)\n",
        "\n",
        "# Статистика изменений depth\n",
        "depth_increase = np.sum(depth_delta > 0)\n",
        "depth_decrease = np.sum(depth_delta < 0)\n",
        "depth_unchanged = np.sum(depth_delta == 0)\n",
        "\n",
        "print(f\"Изменения усиления (gain):\")\n",
        "print(f\"  ↑ Рост: {gain_increase} ({gain_increase/len(arr)*100:.1f}%)\")\n",
        "print(f\"  ↓ Падение: {gain_decrease} ({gain_decrease/len(arr)*100:.1f}%)\")\n",
        "print(f\"  → Без изменений: {gain_unchanged} ({gain_unchanged/len(arr)*100:.1f}%)\")\n",
        "\n",
        "print(f\"\\nИзменения глубины (движение датчика):\")\n",
        "print(f\"  ↑ Увеличение глубины: {depth_increase} ({depth_increase/len(arr)*100:.1f}%)\")\n",
        "print(f\"  ↓ Уменьшение глубины: {depth_decrease} ({depth_decrease/len(arr)*100:.1f}%)\")\n",
        "print(f\"  → Без изменений: {depth_unchanged} ({depth_unchanged/len(arr)*100:.1f}%)\")\n",
        "\n",
        "# Дополнительная статистика движения\n",
        "positive_moves = depth_delta[depth_delta > 0]\n",
        "negative_moves = depth_delta[depth_delta < 0]\n",
        "\n",
        "if len(positive_moves) > 0:\n",
        "    print(f\"\\nСреднее увеличение глубины: {np.mean(positive_moves):.4f} см/кадр\")\n",
        "    print(f\"Макс. увеличение глубины: {np.max(positive_moves):.4f} см/кадр\")\n",
        "if len(negative_moves) > 0:\n",
        "    print(f\"Среднее уменьшение глубины: {np.mean(negative_moves):.4f} см/кадр\")\n",
        "    print(f\"Макс. уменьшение глубины: {np.min(negative_moves):.4f} см/кадр\")\n",
        "\n",
        "# Суммарное перемещение\n",
        "total_movement = np.sum(np.abs(depth_delta))\n",
        "print(f\"\\nСуммарное перемещение датчика: {total_movement:.2f} см\")\n",
        "print(f\"Среднее изменение глубины за кадр: {np.mean(np.abs(depth_delta)):.4f} см\")\n",
        "\n",
        "# 9. Проверка логики (аномалии)\n",
        "print(\"\\n【9】 ПРОВЕРКА ЛОГИКИ (АНОМАЛИИ)\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "# Аномалия 1: высокая частота кадров при высоком уровне артефактов\n",
        "high_fps_high_art = (arr['fps'] > 100) & (arr['art'] > 7)\n",
        "print(f\"Аномалия (fps > 100 и art > 7): {high_fps_high_art.sum()} ({high_fps_high_art.mean()*100:.2f}%)\")\n",
        "\n",
        "# Аномалия 2: очень низкое усиление при нормальной глубине\n",
        "low_gain_normal_depth = (arr['gain'] < 10) & (arr['depth'] > 20)\n",
        "print(f\"Аномалия (gain < 10 и depth > 20): {low_gain_normal_depth.sum()} ({low_gain_normal_depth.mean()*100:.2f}%)\")\n",
        "\n",
        "# Аномалия 3: нулевая частота кадров (должна быть исправлена)\n",
        "zero_fps = arr['fps'] == 1  # после clip минимальное значение 1\n",
        "print(f\"Кадры с fps = 1 (мин. допустимое): {(arr['fps'] == 1).sum()} ({(arr['fps'] == 1).mean()*100:.2f}%)\")\n",
        "\n",
        "# 10. IQR обработка выбросов\n",
        "print(\"\\n【10】 IQR ОБРАБОТКА ВЫБРОСОВ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "# Для gain\n",
        "Q1_gain = np.percentile(arr['gain'], 25)\n",
        "Q3_gain = np.percentile(arr['gain'], 75)\n",
        "IQR_gain = Q3_gain - Q1_gain\n",
        "lower_gain = Q1_gain - 1.5 * IQR_gain\n",
        "upper_gain = Q3_gain + 1.5 * IQR_gain\n",
        "gain_outliers = (arr['gain'] < lower_gain) | (arr['gain'] > upper_gain)\n",
        "print(f\"gain — выбросы: {gain_outliers.sum()} ({gain_outliers.mean()*100:.2f}%)\")\n",
        "\n",
        "# Для fps\n",
        "Q1_fps = np.percentile(arr['fps'], 25)\n",
        "Q3_fps = np.percentile(arr['fps'], 75)\n",
        "IQR_fps = Q3_fps - Q1_fps\n",
        "lower_fps = Q1_fps - 1.5 * IQR_fps\n",
        "upper_fps = Q3_fps + 1.5 * IQR_fps\n",
        "fps_outliers = (arr['fps'] < lower_fps) | (arr['fps'] > upper_fps)\n",
        "print(f\"fps — выбросы: {fps_outliers.sum()} ({fps_outliers.mean()*100:.2f}%)\")\n",
        "\n",
        "# Замена выбросов на медианные значения по датчикам\n",
        "print(\"\\nЗамена выбросов на медианные значения по датчикам...\")\n",
        "replaced_total_gain = 0\n",
        "replaced_total_fps = 0\n",
        "\n",
        "for probe in unique_probes:\n",
        "    mask = arr['probe_id'] == probe\n",
        "\n",
        "    # gain\n",
        "    median_gain_probe = np.median(arr['gain'][mask])\n",
        "    outliers_gain_mask = gain_outliers & mask\n",
        "    replaced_total_gain += outliers_gain_mask.sum()\n",
        "    arr['gain'][outliers_gain_mask] = median_gain_probe\n",
        "\n",
        "    # fps\n",
        "    median_fps_probe = np.median(arr['fps'][mask])\n",
        "    outliers_fps_mask = fps_outliers & mask\n",
        "    replaced_total_fps += outliers_fps_mask.sum()\n",
        "    arr['fps'][outliers_fps_mask] = median_fps_probe\n",
        "\n",
        "print(f\"✓ Заменено выбросов gain: {replaced_total_gain}\")\n",
        "print(f\"✓ Заменено выбросов fps: {replaced_total_fps}\")\n",
        "\n",
        "# 11. Частотный анализ артефактов\n",
        "print(\"\\n【11】 ЧАСТОТНЫЙ АНАЛИЗ АРТЕФАКТОВ\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "unique_art, counts_art = np.unique(arr['art'], return_counts=True)\n",
        "freq_art = counts_art / len(arr)\n",
        "\n",
        "print(\"Распределение индекса артефактов (art):\")\n",
        "for art_val, count, freq in zip(unique_art, counts_art, freq_art):\n",
        "    bar = \"█\" * int(freq * 50)\n",
        "    print(f\"  art={art_val:2d}: {freq*100:5.1f}% ({count:7d}) {bar}\")\n",
        "\n",
        "# Редкие значения\n",
        "rare_threshold = 0.01\n",
        "rare_art = unique_art[freq_art < rare_threshold]\n",
        "if len(rare_art) > 0:\n",
        "    print(f\"\\nРедкие значения art (< {rare_threshold*100}%): {rare_art}\")\n",
        "\n",
        "# 12. Финальная статистика и сохранение\n",
        "print(\"\\n【12】 ФИНАЛЬНАЯ СТАТИСТИКА\")\n",
        "print(\"-\" * 40)\n",
        "\n",
        "print(f\"✓ Всего записей после обработки: {len(arr)}\")\n",
        "print(f\"✓ Память: {arr.nbytes / 1024**2:.2f} МБ\")\n",
        "\n",
        "# Сохраняем результат\n",
        "np.save(\"ultrasound_processed.npy\", arr)\n",
        "print(\"✓ Результат сохранен в 'ultrasound_processed.npy'\")\n",
        "\n",
        "# Дополнительная статистика по ключевым полям\n",
        "print(\"\\nСтатистика по ключевым полям:\")\n",
        "print(f\"  gain: среднее={np.mean(arr['gain']):.2f}, std={np.std(arr['gain']):.2f}, \"\n",
        "      f\"min={np.min(arr['gain']):.2f}, max={np.max(arr['gain']):.2f}\")\n",
        "print(f\"  depth: среднее={np.mean(arr['depth']):.2f}, std={np.std(arr['depth']):.2f}, \"\n",
        "      f\"min={np.min(arr['depth']):.2f}, max={np.max(arr['depth']):.2f}\")\n",
        "print(f\"  fps: среднее={np.mean(arr['fps']):.2f}, std={np.std(arr['fps']):.2f}, \"\n",
        "      f\"min={np.min(arr['fps']):.2f}, max={np.max(arr['fps']):.2f}\")\n",
        "print(f\"  art: среднее={np.mean(arr['art']):.2f}, std={np.std(arr['art']):.2f}, \"\n",
        "      f\"min={np.min(arr['art'])}, max={np.max(arr['art'])}\")\n",
        "\n",
        "# Первые строки результата\n",
        "print(\"\\n【13】 ПЕРВЫЕ 10 СТРОК ОБРАБОТАННЫХ ДАННЫХ\")\n",
        "print(\"-\" * 40)\n",
        "df_final = pd.DataFrame(arr)\n",
        "print(df_final.head(10))\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"✅ ЛАБОРАТОРНАЯ РАБОТА ВЫПОЛНЕНА УСПЕШНО\")\n",
        "print(\"=\" * 60)"
      ]
    }
  ]
}